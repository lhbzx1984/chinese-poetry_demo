# Agnes 密钥；留空时使用程序化背景
AGNES_API_KEY=
# 可选独立图像/赏析密钥，优先于 AGNES_API_KEY
IMAGE_API_KEY=
# OpenAI 兼容服务地址
AI_API_BASE_URL=https://apihub.agnes-ai.com/v1
# 配图模型及尺寸
IMAGE_MODEL=agnes-image-2.5-flash
IMAGE_SIZE=1344x768
# 赏析模型，留空关闭
TEXT_MODEL=agnes-3.0-flash
# 仅首页视频生成脚本使用
VIDEO_MODEL=agnes-video-2.5-flash
# 数据集与数据库路径（相对项目目录）
POETRY_DATA_DIR=data/chinese-poetry
POETRY_DB_PATH=data/poetry.db
# 影片目录，测试或独立磁盘可覆盖
VIDEOS_DIR=data/videos
# 公网部署请设置随机令牌；仅在服务端保存
ADMIN_TOKEN=
# 上传限制（MiB）及影片上限
MAX_VIDEO_MB=100
MAX_VIDEOS=200
# true 时上传也需 Bearer 令牌
REQUIRE_TOKEN_FOR_UPLOAD=false
# 每个 IP 在 60 秒滑动窗口内的上限
RATE_LIMIT_TTS=30
RATE_LIMIT_AI=10
RATE_LIMIT_UPLOAD=5
